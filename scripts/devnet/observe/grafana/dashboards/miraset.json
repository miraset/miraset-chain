{
  "uid": "miraset-devnet",
  "title": "MIRASET devnet measurements",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "15s",
  "tags": [
    "miraset",
    "8.5.3"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Committed TPS (transactions + receipts; every node commits every block, so max across nodes)",
      "datasource": {
        "type": "prometheus",
        "uid": "miraset-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(rate(miraset_block_txs_sum[1m])) + max(rate(miraset_block_receipts_sum[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "miraset-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Commits per second (per node)",
      "datasource": {
        "type": "prometheus",
        "uid": "miraset-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(miraset_commits_total[1m])",
          "datasource": {
            "type": "prometheus",
            "uid": "miraset-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Empty-block share",
      "datasource": {
        "type": "prometheus",
        "uid": "miraset-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(miraset_empty_blocks_total[5m])) / sum(rate(miraset_block_txs_count[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "miraset-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Commit interval p50 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "miraset-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(miraset_commit_interval_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "miraset-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(miraset_commit_interval_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "miraset-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "View timeouts / timeout certificates per second",
      "datasource": {
        "type": "prometheus",
        "uid": "miraset-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",

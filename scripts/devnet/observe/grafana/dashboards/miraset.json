      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(miraset_view_timeouts_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "miraset-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(miraset_timeout_certificates_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "miraset-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",

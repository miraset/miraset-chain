      "targets": [
        {
          "refId": "A",
          "expr": "miraset_committed_height",
          "datasource": {
            "type": "prometheus",
            "uid": "miraset-prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Chain database size",
      "datasource": {
        "type": "prometheus",

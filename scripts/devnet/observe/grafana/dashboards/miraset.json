      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "deriv(miraset_storage_bytes{file=\"chain_db\"}[15m]) * 3600",
          "datasource": {
            "type": "prometheus",
            "uid": "miraset-prometheus"
          }
        }
      ]
    },
